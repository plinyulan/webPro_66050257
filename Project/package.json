{
  "name": "suki-order-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "start": "vite build && node server/index.js --prod",
    "test": "vitest run",
    "reset-db": "node scripts/reset-db.js",
    "test:e2e": "node e2e/flow.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "json-server": "^0.17.4",
    "playwright-core": "^1.49.1",
    "supertest": "^7.0.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
